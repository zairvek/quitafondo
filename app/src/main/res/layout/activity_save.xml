<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_xs">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/Quitafondo.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/back"
                app:icon="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_title"
                android:textColor="@color/paper"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ink_950">

            <dev.quitafondo.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/working"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_l"
                android:gravity="center"
                android:text="@string/nothing_left"
                android:textColor="@color/paper"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </FrameLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="@dimen/space_m">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Quitafondo.SliderLabel"
                    android:layout_width="wrap_content"
                    android:layout_marginEnd="@dimen/space_s"
                    android:text="@string/background" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/backgrounds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedChip="@+id/bgTransparent"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bgTransparent"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bg_transparent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bgWhite"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bg_white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bgBlack"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bg_black" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bgColor"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bg_color" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bgBlur"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bg_blur" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bgPhoto"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bg_photo" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </HorizontalScrollView>

        <include
            android:id="@+id/rowSmooth"
            layout="@layout/view_slider_row" />

        <include
            android:id="@+id/rowOutline"
            layout="@layout/view_slider_row" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/trim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:paddingHorizontal="@dimen/space_m"
            android:text="@string/trim"
            android:textColor="@color/paper"
            android:textSize="@dimen/text_small" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_m"
            app:checkedButton="@+id/formatPng"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/formatPng"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/format_png"
                android:textSize="@dimen/text_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/formatJpg"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/format_jpg"
                android:textSize="@dimen/text_small" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/space_m"
            android:layout_marginVertical="@dimen/space_s"
            android:text="@string/save"
            android:textSize="16sp" />
    </LinearLayout>

    <include
        android:id="@+id/progress"
        layout="@layout/view_progress"
        android:visibility="gone" />
</FrameLayout>
